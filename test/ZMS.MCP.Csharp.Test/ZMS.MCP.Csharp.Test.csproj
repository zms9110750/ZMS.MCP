<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ZMS.MCP.Csharp 单元测试</Description>
    <!-- xUnit1051 建议给"接受 CancellationToken 的方法"传 token，但本项目的工具 API 是同步设计（MCP 工具方法不带 token） -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZMS.MCP.Csharp\ZMS.MCP.Csharp.csproj" />
  </ItemGroup>

  <!-- 构建输出被重定向到仓库外，运行时定位不到仓库根：编译期写进程序集元数据 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
