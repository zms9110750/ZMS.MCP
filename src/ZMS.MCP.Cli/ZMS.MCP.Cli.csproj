<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ZMS.MCP — Model Context Protocol stdio server</Description>
    <DefineConstants>$(DefineConstants);IS_MCP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.11" />
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

</Project>
